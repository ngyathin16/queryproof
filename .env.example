# Optional: uv run --env-file .env queryproof
# Copy this file to .env; .env is ignored by Git. Do not paste keys into the browser.
# Default deterministic reviews require no model or key.
QUERYPROOF_PROVIDER=ollama
QUERYPROOF_MODEL=qwen3.5:9b
QUERYPROOF_OLLAMA_URL=http://127.0.0.1:11434

# Hosted alternative: uncomment these lines and replace the model/key locally.
# Use an API/model supporting chat completions, JSON mode and max_completion_tokens.
# QUERYPROOF_PROVIDER=openai-compatible
# QUERYPROOF_API_BASE=https://api.openai.com/v1
# QUERYPROOF_MODEL=your-model-id
# QUERYPROOF_API_KEY=replace-with-your-own-key
